[Unit]
Description=Chiron adaptive textbook server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chiron
Group=chiron
WorkingDirectory=/var/lib/chiron
Environment=HOME=/var/lib/chiron
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=CHIRON_AUTH_TOKEN_FILE=/etc/chiron/auth-token
ExecStart=/usr/local/libexec/chiron-server -addr :8080 -config /etc/chiron/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
StateDirectory=chiron
CacheDirectory=chiron
RuntimeDirectory=chiron
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/chiron /var/cache/chiron /var/tmp/chiron

[Install]
WantedBy=multi-user.target
